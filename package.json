{
  "name": "old-school-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Old School Apps catalog and Typewriter Notes web app",
  "scripts": {
    "check": "node --check typewriter-notes.js && node --check desk-calendar-planner.js && node --check script.js && node --check api/*.js && tsc -p vhs-watchlist-src/tsconfig.json && tsc -p rolodex-contacts-src/tsconfig.json",
    "test:security": "node --test tests/auth-security.test.js",
    "dev:vhs": "vite --config vhs-watchlist-src/vite.config.ts",
    "build:vhs": "vite build --config vhs-watchlist-src/vite.config.ts"
    ,"build:rolodex": "vite build --config rolodex-contacts-src/vite.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^22.3.2"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  }
}
